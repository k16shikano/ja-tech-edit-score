# 推敲採点 Web サービス（CPU）。Fly.io 公開用。
FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers \
    PRIMARY_MODEL=/app/outputs/pref-sentseq-3e4 \
    GATE_MODEL=/app/outputs/pref-bt \
    DIRECTION_MODEL=/app/outputs/pref-sentseq-anchor-2stage-v2 \
    CALIBRATION_PATH=/app/outputs/acceptance_margin_calibration.json \
    RATE_LIMIT_PER_IP=10 \
    RATE_LIMIT_WINDOW_SECONDS=86400 \
    MAX_TEXT_CHARS=8000 \
    MIN_MARGIN=3.7 \
    GATE_MIN_MARGIN=0.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*

COPY requirements-serve.txt ./
RUN pip install --no-cache-dir -U pip \
  && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
  && pip install --no-cache-dir -r requirements-serve.txt \
  && apt-get purge -y build-essential \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

# 実行時に必要なスクリプトだけ同梱（学習スクリプトは LinearRewardHead / SentSeq 定義の import 元）
COPY scripts/score_server.py \
     scripts/pref_scorer.py \
     scripts/pref_bt_runtime.py \
     scripts/pref_sentseq_runtime.py \
     scripts/pref_static_utils.py \
     scripts/sentseq_utils.py \
     scripts/train_pref_bt.py \
     scripts/train_pref_sentseq.py \
     scripts/

COPY web/index.html web/index.html
COPY outputs/pref-sentseq-3e4/model.pt outputs/pref-sentseq-3e4/metrics.json outputs/pref-sentseq-3e4/
COPY outputs/pref-bt/model.joblib outputs/pref-bt/metrics.json outputs/pref-bt/
COPY outputs/pref-sentseq-anchor-2stage-v2/model.pt outputs/pref-sentseq-anchor-2stage-v2/metrics.json outputs/pref-sentseq-anchor-2stage-v2/
COPY outputs/acceptance_margin_calibration.json outputs/acceptance_margin_calibration.json

# コールドスタート短縮のため ruri をビルド時に取得
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('cl-nagoya/ruri-v3-30m')"

EXPOSE 8080
CMD ["sh", "-c", "python scripts/score_server.py --host 0.0.0.0 --port ${PORT:-8080}"]
