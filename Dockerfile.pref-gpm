# 高火力 DOK 向け: A1 段落内ペアと B 節三つ組みで GPM 評価器を学ぶ
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

COPY requirements-pref-sentseq.txt ./
RUN pip install --no-cache-dir -U pip \
  && pip install --no-cache-dir -r requirements-pref-sentseq.txt \
  && pip install --no-cache-dir joblib scikit-learn

COPY scripts/train_pref_gpm.py scripts/
COPY scripts/pref_gpm_runtime.py scripts/
COPY scripts/train_pref_sentseq.py scripts/
COPY scripts/sentseq_utils.py scripts/pref_static_utils.py scripts/
COPY scripts/pref_pair_utils.py scripts/setwise_triple_utils.py scripts/
COPY scripts/pref_sentseq_runtime.py scripts/
COPY scripts/dok_pref_gpm.sh /app/dok_pref_gpm.sh
RUN chmod +x /app/dok_pref_gpm.sh

COPY data/pref_keep_split_hunk/train.jsonl data/pref_keep_split_hunk/train.jsonl
COPY data/pref_keep_split_hunk/valid.jsonl data/pref_keep_split_hunk/valid.jsonl
COPY data/section_middle/pref_train.jsonl data/section_middle/pref_train.jsonl
COPY data/section_middle/pref_valid.jsonl data/section_middle/pref_valid.jsonl

ENV PYTHONUNBUFFERED=1
ENV DEVICE=cuda
ENV EMBED_MODEL=cl-nagoya/ruri-v3-30m
ENV EPOCHS=40
ENV LR=3e-4
ENV BATCH_SIZE=32
ENV HEAD_DIM=4
ENV HEAD_HIDDEN=0
ENV D_MODEL=256
ENV NUM_LAYERS=2
ENV MAX_SENTS=128
ENV MAX_SEQ_LENGTH=256
ENV SEED=0
ENV DROP_GEN_OVER_DRAFT=0
ENV NORMALIZE_EMBEDDING=0

ENTRYPOINT ["/bin/bash", "/app/dok_pref_gpm.sh"]
