!data/pref_keep/build_report_section.json
!data/generated_pref_experiment/
!data/generated_pref_experiment/folds_section/
!data/generated_pref_experiment/folds_section/**
!data/section_middle/
!data/section_middle/**
docs
*.md
!docs/FLY-SERVE.md
outputs/pref-ce*
outputs/pref-bt-*
!outputs/pref-bt-keep
!outputs/pref-bt-keep/**
outputs/pref-sentseq
outputs/pref-sentseq-*
!outputs/pref-sentseq-keep
!outputs/pref-sentseq-keep/**
!outputs/pref-sentseq-3e4
!outputs/pref-sentseq-3e4/**
!outputs/pref-sentseq-anchor-2stage-v2
!outputs/pref-sentseq-anchor-2stage-v2/**
outputs/hard_eval*
outputs/eval*
outputs/acceptance_margin_calibration_anchor.json
Dockerfile.pref-*
Dockerfile.edit-*
Dockerfile.steering
scripts/*
!scripts/score_server.py
!scripts/pref_scorer.py
!scripts/pref_bt_runtime.py
!scripts/pref_sentseq_runtime.py
!scripts/pref_static_utils.py
!scripts/sentseq_utils.py
