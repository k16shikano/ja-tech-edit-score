.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
run/

# data/ は原稿本文を含むため既定で無視する。
# 公開してよいもの（スキーマ・テンプレート・規範）だけを許可する。
data/*
!data/.gitkeep
!data/README.md
!data/examples.schema.json
!data/examples.template.jsonl
!data/hard_eval.schema.json
!data/hard_eval.template.jsonl
!data/batch_import_repos.example.txt
!data/hard_eval/
data/hard_eval/*
!data/hard_eval/README.md
tmp/

# Other output under outputs/ (pref-static model is bundled)
outputs/*
!outputs/README.md
!outputs/pref-static/
outputs/pref-static/*
!outputs/pref-static/model.joblib
!outputs/pref-static/metrics.json

# Keep templates / schemas
!data/.gitkeep
!data/examples.schema.json
!data/examples.template.jsonl
!data/hard_eval.schema.json
!data/hard_eval.template.jsonl
!data/README.md
!data/batch_import_repos.example.txt
