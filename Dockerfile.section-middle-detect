# 高火力 DOK 向け: 節ペアの三つ組みで人間検出評価器を学ぶ
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /app

COPY requirements-pref-sentseq.txt ./
RUN pip install --no-cache-dir -U pip \
  && pip install --no-cache-dir -r requirements-pref-sentseq.txt \
  && pip install --no-cache-dir joblib scikit-learn

COPY scripts/train_pref_detect.py scripts/
COPY scripts/train_pref_sentseq.py scripts/
COPY scripts/setwise_triple_utils.py scripts/
COPY scripts/sentseq_utils.py scripts/pref_static_utils.py scripts/
COPY scripts/dok_section_middle_detect.sh /app/dok_section_middle_detect.sh
RUN chmod +x /app/dok_section_middle_detect.sh

COPY data/section_middle/pref_train.jsonl data/section_middle/pref_train.jsonl
COPY data/section_middle/pref_valid.jsonl data/section_middle/pref_valid.jsonl

ENV PYTHONUNBUFFERED=1
ENV DEVICE=cuda
ENV EMBED_MODEL=cl-nagoya/ruri-v3-30m
ENV EPOCHS=40
ENV LR=3e-4

ENTRYPOINT ["/bin/bash", "/app/dok_section_middle_detect.sh"]
